# ─────────────────────────────────────────────────────────────
# PadlizsanFanSub – Környezeti változók sablonja
# Másold át: cp .env.example .env  – majd töltsd ki az értékeket
# ─────────────────────────────────────────────────────────────

# ── Szerver ──────────────────────────────────────────────────
PORT=3000
# Az oldal teljes URL-je (trailing slash nélkül)
SITE_URL=https://pelda.hu
BASE_URL=https://pelda.hu
# Az oldal neve (email sablonokban és lábléjcben jelenik meg)
SITE_NAME=PadlizsanFanSub

# A manga könyvtárak gyökérútvonala a szerveren
MANGA_ROOT=/mnt/manga

# Bejelentkezési zárolás: hány percre zárja ki a fiókot (sikertelen próbálkozás után)
LOCK_HOURS=1

# ── Adatbázis (PostgreSQL) ────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGDATABASE=padli
PGUSER=padli
PGPASSWORD=valtozz_meg

# Alternatív kapcsolati string (ha az egyedi PG* változókat nem használod)
DATABASE_URL=postgresql://padli:valtozz_meg@localhost:5432/padli

# ── Cloudflare ────────────────────────────────────────────────
# Cloudflare Zone ID (dashboard → Overview → Zone ID)
CF_ZONE_ID=

# Cloudflare API token (Zone:Cache Purge jogosultsággal)
CF_API_TOKEN=

# Az oldal domainje Cloudflare-en (cache purge-höz)
CF_DOMAIN=https://pelda.hu

# ── Cloudflare R2 (képtárolás) ───────────────────────────────
# Account ID: https://dash.cloudflare.com → R2 Object Storage
R2_ACCOUNT_ID=

# R2 bucket neve
R2_BUCKET_NAME=manga-images

# R2 Access Key és Secret (R2 → Manage API tokens)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# A bucket publikus elérési URL-je (R2 → Settings → Custom Domain)
R2_PUBLIC_URL=https://cdn.pelda.hu

# ── Email (Nodemailer) ───────────────────────────────────────
MAIL_HOST=smtp.pelda.hu
MAIL_PORT=465
MAIL_USER=noreply@pelda.hu
MAIL_PASS=
MAIL_FROM="PadlizsanFanSub <noreply@pelda.hu>"

# ── Auth & Biztonság ─────────────────────────────────────────
# Hosszú, véletlenszerű string – session titkosításhoz
SESSION_SECRET=generate_egy_hosszu_veletlenszeru_stringet

# Admin panel → Szerver fül jelszava (külön a weboldal admintól)
SERVER_ADMIN_PASSWORD=generate_egy_hosszu_veletlenszeru_stringet

# ── Stripe (opcionális – shop funkció) ───────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Billingo (opcionális – magyar e-számla) ──────────────────
# Billingo v3 API kulcs (https://app.billingo.hu → API)
BILLINGO_API_KEY=

# ── Patreon (opcionális – támogatói rendszer) ─────────────────
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_ACCESS_TOKEN=
PATREON_CAMPAIGN_ID=
PATREON_REDIRECT_URI=https://pelda.hu/api/patreon/callback
PATREON_WEBHOOK_SECRET=

# ── AniList (opcionális – manga metaadat szinkron) ────────────
# Regisztrálj egy OAuth alkalmazást: https://anilist.co/settings/developer
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
ANILIST_REDIRECT=https://pelda.hu/api/anilist/callback

# ── Discord (opcionális – értesítések) ───────────────────────
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_NEW_CHAPTERS_CHANNEL_ID=

# ── AI / Fordítás (opcionális) ───────────────────────────────
# OpenAI API kulcs (PadliCrome fordítás, FansubÉlet generátor)
OPENAI_API_KEY=sk-...

# Gemini API kulcs(ok) — Padli AI chatbot (site chat + Discord), cím/név
# validáció, felirat-fordítás. Csak az első indításkor kerülnek be a
# gemini_keys táblába (rotációs pool) — utána admin panelről bővíthető.
# Legalább egy kitöltése szükséges a Padli AI chatbothoz.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# DeepL API kulcs (alternatív fordítás)
DEEPL_API_KEY=

# Hugging Face API token
HF_API_TOKEN=

# Külső manga fordító szolgáltatás URL-je
MANGA_TRANSLATOR_URL=http://localhost:8000

# JWT secret a manga fordító API-hoz
MANGA_JWT_SECRET=

# OCR szolgáltatás URL-je (szövegfelismerés képekről)
OCR_URL=http://localhost:8001

# ── ComfyUI (opcionális – AI képgenerálás) ───────────────────
COMFY_URL=http://localhost:8188
COMFY_INPAINT_MODEL=v1-5-pruned-emaonly.safetensors
COMFY_LORA_MODEL=
COMFY_USE_LORA=false

# ── Anime feliratok (opcionális – .srt/.ass katalógus) ───────
# Megosztott titkos kulcs egy külső feltöltő szkripthez (nincs webes
# feltöltő UI, csak API). Hosszú, véletlenszerű string legyen.
ANIME_UPLOAD_API_SECRET=

# ── PadliCrome desktop alkalmazás ────────────────────────────
PADLI_API_KEY=
PADLI_API_PORT=3001
PADLI_SECRET_KEY=
# Külső API/fordítóeszköz origin — CSP whitelist-be kerül (pl. https://api.pelda.hu)
PADLI_API_ORIGIN=
# PadliCrome .exe letöltési URL (opcionális felülírás, alapértelmezett: SITE_URL/downloads/...)
PADLI_DOWNLOAD_URL=

# ── Backup ───────────────────────────────────────────────────
# Hány napig őrizze meg a biztonsági mentéseket
BACKUP_KEEP_DAYS=7
